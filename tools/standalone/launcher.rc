#include <winver.h>
/* build_standalone.py passes the real version (-DH3D_VER=3,1,3,0 -DH3D_VER_STR=\"3.1.3\");
   the defaults below only apply to a hand build. */
#ifndef H3D_VER
#  define H3D_VER 0,0,0,0
#endif
#ifndef H3D_VER_STR
#  define H3D_VER_STR "0.0.0"
#endif
1 ICON "heaven3d.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION H3D_VER
PRODUCTVERSION H3D_VER
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Heaven3D"
      VALUE "FileDescription", H3D_DESC
      VALUE "ProductName", "Heaven3D"
      VALUE "ProductVersion", H3D_VER_STR
      VALUE "FileVersion", H3D_VER_STR
      VALUE "LegalCopyright", "Apache License 2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
